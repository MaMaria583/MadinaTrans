# ---------------------------------------------------------------------------
# Madina Trans — variables d'environnement
# Copiez ce fichier en .env.local (local) ou renseignez-les dans Vercel
# (Settings → Environment Variables). Ne commitez JAMAIS de vraies valeurs.
# ---------------------------------------------------------------------------

# ——— Affichage ———
# Mode démonstration (bandeau, badges « À confirmer », site non indexé).
# Laisser "true" tant que les informations ne sont pas validées par Madina Trans.
NEXT_PUBLIC_DEMO_MODE=true

# URL publique du site (canonique, Open Graph, sitemap). Sur Vercel, si vide,
# l'URL de production Vercel est utilisée.
NEXT_PUBLIC_SITE_URL=

# ——— Envoi des demandes par e-mail (Resend) — SERVEUR UNIQUEMENT ———
# Clé API Resend (https://resend.com/api-keys) — commence par "re_".
RESEND_API_KEY=
# Expéditeur : adresse d'un domaine VÉRIFIÉ dans Resend.
# Ex. : Madina Trans <devis@madinatrans.ml>
RESEND_FROM_EMAIL=
# Destinataire(s) des demandes de devis — plusieurs adresses séparées par des virgules.
ADMIN_EMAIL=
# Destinataire des messages de contact (facultatif, sinon ADMIN_EMAIL).
CONTACT_EMAIL=

# ——— Alternative : webhook JSON (utilisé seulement si Resend n'est pas configuré) ———
FORM_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=
