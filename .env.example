# ---------------------------------------------------------------------------
# Madina Trans — variables d'environnement
# Copiez ce fichier en .env.local (local) ou renseignez-les dans Vercel.
# Ne commitez JAMAIS de vraies valeurs : .env* est ignoré par Git.
# ---------------------------------------------------------------------------

# Mode démonstration (bandeau, badges « À confirmer », site non indexé).
# Laisser "true" tant que les informations ne sont pas validées par Madina Trans.
NEXT_PUBLIC_DEMO_MODE=true

# URL publique du site (balises canoniques, Open Graph, sitemap).
# Sur Vercel, si absente, l'URL de production Vercel est utilisée.
NEXT_PUBLIC_SITE_URL=

# Réception des formulaires (devis + contact) — côté serveur uniquement.
# URL d'un service recevant un POST JSON : Formspree, Make, Zapier, n8n,
# Google Apps Script, CRM… Si vide : mode démonstration (rien n'est transmis).
FORM_WEBHOOK_URL=

# Jeton optionnel envoyé en en-tête "Authorization: Bearer <jeton>".
FORM_WEBHOOK_TOKEN=
